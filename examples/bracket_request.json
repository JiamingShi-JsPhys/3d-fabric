{
  "prompt": "一块 120x70x8 的钣金转接板：四角 R8 圆角，中间 40x20 的矩形通孔，四角各一个 Ø4.5 通孔，孔中心距边 12mm",
  "commands": [
    {"command": "parameters.add", "params": {"name": "L", "expression": "120 mm"}},
    {"command": "parameters.add", "params": {"name": "W", "expression": "70 mm"}},
    {"command": "parameters.add", "params": {"name": "T", "expression": "8 mm"}},
    {"command": "parameters.add", "params": {"name": "inset", "expression": "12 mm"}},
    {"command": "parameters.add", "params": {"name": "hole", "expression": "4.5 mm"}},
    {"command": "sketch.create", "params": {"plane": "XY", "name": "Outline"}},
    {"command": "sketch.draw.dimensioned", "params": {"command": "sketch.rectangle.center", "params": {"center": [0, 0], "corner": [60, 35]}, "dimensions": {"width": "L", "height": "W"}}},
    {"command": "sketch.finish", "params": {}},
    {"command": "solid.extrude", "params": {"distance": "T", "name": "Plate"}},
    {"command": "solid.fillet", "params": {"edges": [[60, 35, 4], [-60, 35, 4], [60, -35, 4], [-60, -35, 4]], "radius": 8, "name": "Corners"}},
    {"command": "sketch.create", "params": {"plane": "XY", "name": "Cutout", "offset": "T"}},
    {"command": "sketch.draw.dimensioned", "params": {"command": "sketch.rectangle.center", "params": {"center": [0, 0], "corner": [20, 10]}, "dimensions": {"width": "40", "height": "20"}}},
    {"command": "sketch.finish", "params": {}},
    {"command": "solid.extrude", "params": {"operation": "cut", "through_all": true, "direction": "negative", "name": "Window"}},
    {"command": "sketch.create", "params": {"plane": "XY", "name": "BoltPts", "offset": "T"}},
    {"command": "sketch.point", "params": {"point": [48, 23]}},
    {"command": "sketch.dimension", "params": {"entities": ["origin", "p1"], "type": "horizontal", "value": "L/2 - inset"}},
    {"command": "sketch.dimension", "params": {"entities": ["origin", "p1"], "type": "vertical", "value": "W/2 - inset"}},
    {"command": "sketch.finish", "params": {}},
    {"command": "solid.hole", "params": {"sketch": "BoltPts", "diameter": "hole", "name": "Bolt"}},
    {"command": "solid.pattern.rectangular", "params": {"features": ["Bolt"], "dir1": [-1, 0, 0], "count1": 2, "spacing1": "L - 2*inset", "dir2": [0, -1, 0], "count2": 2, "spacing2": "W - 2*inset", "name": "Bolts"}}
  ],
  "output": "bracket.stl",
  "quality": "fine"
}
